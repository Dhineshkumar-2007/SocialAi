# Hugging Face Spaces Environment Variables
# Set these in HF Spaces Settings > Repository Secrets

# Database (uses SQLite by default for simplicity)
DATABASE_URL=sqlite:///societal_ai.db

# AI Configuration
AI_ENABLED=true
SOCIALAI_SKIP_WARMUP=0
BGE_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLASSIFIER_MODEL=MoritzLaurer/distilbert-base-mnli
VISION_MODEL=nlpconnect/vit-gpt2-image-captioning

# Security
SECRET_KEY=change-me-in-production

# File uploads
UPLOAD_DIR=uploads
MAX_CONTENT_LENGTH=10485760

# CORS
CORS_ORIGINS=*

# University settings
UNIVERSITY_RESPONSE_TIMEOUT_HOURS=72
MAX_ASSIGNMENT_ROUNDS=3

# Hugging Face Token (optional, for private models)
HF_TOKEN=
